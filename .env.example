# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.
# Tous les secrets restent côté serveur : aucune de ces variables n'est préfixée NEXT_PUBLIC_.

# Base PostgreSQL (docker compose up -d fournit celle-ci)
DATABASE_URL="postgresql://epp:epp@localhost:5432/epp_dev"

# Clé de signature des sessions et des codes (32 octets aléatoires : openssl rand -hex 32)
SESSION_SECRET=""

# SMS : "simulation" (codes affichés dans les journaux serveur) ou le nom d'un fournisseur branché
SMS_PROVIDER="simulation"
# Nom d'expéditeur affiché (s'il est validé par l'opérateur)
SMS_SENDER="GESTEPP"
# Orange SMS API (SMS_PROVIDER="orange") : application créée sur developer.orange.com
ORANGE_SMS_CLIENT_ID=""
ORANGE_SMS_CLIENT_SECRET=""
# Numéro expéditeur du contrat Orange (ex. 0700000000)
ORANGE_SMS_EXPEDITEUR=""
# En production, afficher les SMS simulés à l'écran (démonstration uniquement) : "oui"
AFFICHER_SMS_SIMULES=""

# Paiement de l'abonnement : fournisseurs proposés au directeur, séparés par des virgules.
# "simulation" (démonstration, désactivé en production sauf AUTORISER_PAIEMENT_SIMULE=oui), "cinetpay", "wave".
PAYMENT_PROVIDERS="simulation"
AUTORISER_PAIEMENT_SIMULE=""
# CinetPay (Orange Money, MTN MoMo, Moov Money, Wave, cartes)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""
# Wave Checkout
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""

# Tâches quotidiennes (rappels d'abonnement) : POST /api/taches avec "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# Création du compte administrateur de la plateforme (npm run admin:creer)
ADMIN_TELEPHONE=""
ADMIN_MOT_DE_PASSE=""
ADMIN_NOM="Administrateur"

# E-mail (notifications) : "simulation" (journaux du serveur) ou "resend" (RESEND_API_KEY)
EMAIL_PROVIDER="simulation"
RESEND_API_KEY=""
MAIL_FROM="GESTION SCOLAIRE EPP <no-reply@example.ci>"

# URL publique de l'application (liens dans les SMS et e-mails, retours de paiement)
APP_URL="http://localhost:3000"

# Base dédiée aux tests d'intégration (npm test) ; elle est vidée à chaque test.
TEST_DATABASE_URL="postgresql://epp:epp@localhost:5432/epp_test"
