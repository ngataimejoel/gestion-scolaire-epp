# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.
# Tous les secrets restent côté serveur : aucune de ces variables n'est préfixée NEXT_PUBLIC_.

# Base PostgreSQL (docker compose up -d fournit celle-ci)
DATABASE_URL="postgresql://epp:epp@localhost:5432/epp_dev"

# Clé de signature des sessions et des codes (32 octets aléatoires : openssl rand -hex 32)
SESSION_SECRET=""

# SMS : "simulation" (codes affichés dans les journaux serveur) ou le nom d'un fournisseur branché
SMS_PROVIDER="simulation"
SMS_API_KEY=""
SMS_SENDER="GESTEPP"

# Paiement de l'abonnement : "simulation" ou fournisseur (ex. cinetpay, paydunya, fedapay)
PAYMENT_PROVIDER="simulation"
PAYMENT_API_KEY=""
PAYMENT_SITE_ID=""
PAYMENT_WEBHOOK_SECRET=""

# E-mail (notifications) : laisser vide pour désactiver
SMTP_URL=""
MAIL_FROM="GESTION SCOLAIRE EPP <no-reply@example.ci>"

# URL publique de l'application (liens dans les SMS et e-mails, retours de paiement)
APP_URL="http://localhost:3000"
